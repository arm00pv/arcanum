[Unit]
Description=Arcanum - refresh the shared Digimon catalogue from Heroicc
Documentation=https://github.com/arm00pv/arcanum
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zixen
Group=zixen
WorkingDirectory=/home/zixen/arcanum
# The whole of this job is the catalogue, and that is why Digimon has a unit of
# its own rather than a line in one of the three samplers' scripts: Heroicc
# quotes no price of any kind for any card, so there is nothing to sample here
# and replace_prices is never called. A unit that spent its night polling a
# source for prices it does not publish would be a unit that failed every
# night on the assertion at the end of the run.
#
# It is one of the two long imports of the night and the timeout says so: the
# source lists 93 releases and answers a set one card at a time - 7,618 cards
# measured on 2026-09-21, 3,331 of them parallels - and a full walk of them took
# 25 minutes measured (1,498s for the first run, 1,542s for the run after the
# ownership rule changed). The hour below is twice what the run needs, which is
# what a nightly job fetching seven and a half thousand cards should be given.
# The numbers behind that, and the licence question the server half of this game
# had to answer before there was one, are in docs/catalogue-import-digimon.md.
#
# The lock the importer takes by itself - /tmp/arcanum-catalog-digimon.lock, its
# own default - is per game, so this run does not collide with the timers above
# it in the night, and a hand-run import during the same minute is refused
# rather than allowed to interleave.
ExecStart=/usr/bin/python3 /home/zixen/arcanum/tool/import_digimon_catalogue.py
# The database URL, and nothing else, reaches this process. The file is mode 600
# and systemd reads it as root; the script is given these as variables rather
# than as arguments of its own, because an argument is readable in a process
# listing by every user on the host.
EnvironmentFile=/home/zixen/arcanum/supabase.env
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
StandardOutput=append:/home/zixen/arcanum/logs/digimon_import.log
StandardError=append:/home/zixen/arcanum/logs/digimon_import.log
