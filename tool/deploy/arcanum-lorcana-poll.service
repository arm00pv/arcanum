[Unit]
Description=Arcanum - sample Lorcana prices and refresh its shared catalogue
Documentation=https://github.com/arm00pv/arcanum
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zixen
Group=zixen
WorkingDirectory=/home/zixen/arcanum
# Two jobs, one sweep. The catalogue import is a second thing done with the 24
# Lorcast responses this run already downloads, so it costs no extra traffic
# and no extra CPU or IO on a host that runs close to its limits; what it does
# add is about sixteen seconds of psql round trips on an unchanged night, in a
# window whose next job is fifteen minutes away. That is why it rides in this
# unit instead of taking a second window and fetching the same 3,208 cards
# again. The measurement and the argument are in docs/catalogue-refresh.md.
ExecStart=/usr/bin/python3 /home/zixen/arcanum/poll_lorcana_prices.py --db /home/zixen/arcanum/data/lorcana_prices.db --catalog --skip-polled-today
# The credentials come from the environment, which is where the importer reads
# them: the file is mode 600, systemd reads it as root, and the script is given
# these as variables rather than as arguments of its own.
EnvironmentFile=/home/zixen/arcanum/supabase.env
# A day that is not sampled is a day permanently missing from the trend: no
# source anywhere holds this game's price history, so it cannot be backfilled
# later. That is also what --skip-polled-today protects: the sweep keeps its own
# record of what it has already sampled, so a hand-run or a catch-up run cannot
# overwrite the day's prices with a later reading. On a normal night at 04:40 it
# skips nothing, because nothing has been sampled yet that day.
#
# Nice and idle keep the sweep out of the way of everything else.
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=3600
StandardOutput=append:/home/zixen/arcanum/logs/poll_lorcana_prices.log
StandardError=append:/home/zixen/arcanum/logs/poll_lorcana_prices.log
