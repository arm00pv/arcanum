[Unit]
Description=Arcanum - sample Pokemon prices from TCGdex
Documentation=https://github.com/arm00pv/arcanum
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zixen
Group=zixen
WorkingDirectory=/home/zixen/arcanum
# --skip-polled-today makes a re-run cheap: the script keeps its own record of
# which cards it has already sampled, so an interrupted day resumes rather than
# starting over.
ExecStart=/usr/bin/python3 /home/zixen/arcanum/poll_pokemon_prices.py --db /home/zixen/arcanum/data/pokemon_prices.db --skip-polled-today
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
StandardOutput=append:/home/zixen/arcanum/logs/pokemon_poll.log
StandardError=append:/home/zixen/arcanum/logs/pokemon_poll.log
